// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Paciente {
  id_paciente Int @id @default(autoincrement())
  nombre String
  apellido String
  email String @unique
  telefono String
  fechaNacimiento DateTime @map("fecha_nacimiento")
  activo Boolean @default(true)
  citas Cita[]
}

model Doctor {
  id_doctor Int @id @default(autoincrement())
  nombre String
  apellido String
  especialidad String
  telefono String?
  email String @unique
  activo Boolean @default(true)
  citas Cita[]
}

model Cita {
  id_cita Int @id @default(autoincrement())
  fecha DateTime
  estado estados @default(PROGRAMADA)
  id_paciente Int
  id_doctor Int
  consultas  ConsultasMedicas? 
  doctor Doctor @relation(fields: [id_doctor], references:[id_doctor])
  paciente Paciente @relation(fields:[id_paciente], references: [id_paciente])
}

model ConsultasMedicas {
  id_consulta_medica Int @id @default(autoincrement())
  id_cita Int @unique
  cita Cita @relation(fields: [id_cita], references: [id_cita])
  diagnostico String?
  tratamiento String?
  observaciones String?
}

enum estados {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

enum Role {
  RECEPCION
  DOCTOR
  ADMIN
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     Role     @default(RECEPCION)
  creadoEn DateTime @default(now())

  @@map("users")
}